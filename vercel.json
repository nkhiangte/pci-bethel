{
  "rewrites": [
    {
      "source": "/announcements/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[sS]lurp|[fF]acebook|[fF]acebot|[tT]witter|[wW]hats[aA]pp|[tT]elegram|[sS]lack|[dD]iscord|[pP]interest|[gG]oogle|[lL]inked[iI]n|[mM]eta[uU][rR][iI]|[aA]pplebot).*"
        }
      ],
      "destination": "/api/share?type=announcements&id=:id"
    },
    {
      "source": "/articles/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[sS]lurp|[fF]acebook|[fF]acebot|[tT]witter|[wW]hats[aA]pp|[tT]elegram|[sS]lack|[dD]iscord|[pP]interest|[gG]oogle|[lL]inked[iI]n|[mM]eta[uU][rR][iI]|[aA]pplebot).*"
        }
      ],
      "destination": "/api/share?type=articles&id=:id"
    },
    {
      "source": "/articles",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[sS]lurp|[fF]acebook|[fF]acebot|[tT]witter|[wW]hats[aA]pp|[tT]elegram|[sS]lack|[dD]iscord|[pP]interest|[gG]oogle|[lL]inked[iI]n|[mM]eta[uU][rR][iI]|[aA]pplebot).*"
        }
      ],
      "destination": "/api/share?type=articles"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
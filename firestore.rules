rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================
    // Helper functions
    // ===============================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == "KvdUzxS37ESXZsX6xspTQ7oEeo83" ||
        request.auth.token.email == "nkhiangte@gmail.com" ||
        request.auth.token.email == "kohhranb@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
          )
        )
      );
    }

    // ===============================
    // Publicly readable collections
    // ===============================

    match /stats/{allDocs=**} {
      allow read, write: if true;
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /archives/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bialMembers/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /committees/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /committees/{committeeId}/committeeReports/{reportId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /committees/{committeeId}/committeeImages/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /committees/{committeeId}/propertyRecords/{recordId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /elders/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pastors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /proPastors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /calendar_events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery_folders/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inkhawmChanvo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /upaBials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ktpBudget/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ktpLeaders/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ktpHruaitute/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ktpContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ktpGallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ktpProductions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /production_folders/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fellowship/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fellowship/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ktpWhosWho/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ktpYearlyReports/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /kpvmBuhfaitham/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /kpvmNitinInkhawm/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /financeReports/{reportId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ministries/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /missionaries/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /records/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sundaySchoolDepartments/{deptId}/sections/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sundaySchoolDepartments/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sundaySchoolSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sundaySchoolWeeklyReports/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sundaySchoolSyllabus/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sundaySchoolQuarterlySyllabus/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ss_teachers/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /thawhlawm/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if isAdmin();
    }

    match /weeklyDuties/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ktpMinutesArchives/{year} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bethelFolders/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bethelPdfs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================
    // User profiles
    // ===============================

    match /khYearlyReportsPdfs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /library_books/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /library_members/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /library_transactions/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /library_settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
    }

  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================
    // Admin check function
    // ===============================
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
    }

    // ===============================
    // Publicly readable collections
    // (write access: admin only for most)
    // ===============================

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /archives/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /committees/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Rule for 'elders' collection: Publicly readable, admin-writable
    match /elders/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rule for 'pastors' collection: Publicly readable, admin-writable
    match /pastors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rule for 'proPastors' collection:
    // Publicly readable. Admins can create, update, AND DELETE.
    match /proPastors/{docId} {
      allow read: if true;
      allow write: if isAdmin(); // Reverted to allow all write operations for admins
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inkhawmChanvo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /upaBials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ktpBudget/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ktpLeaders/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ministries/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Unified collection for all record types: baptism, wedding, death, inkhawmpui
    // This single rule covers the new 'wedding' records as they are stored here with type='wedding'
    match /records/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sundaySchoolDepartments/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /weeklyDuties/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================
    // User profiles
    // ===============================

    match /users/{userId} {
      // Any authenticated user can read their own profile or profiles of others
      allow read: if request.auth != null;

      // Users can edit their own profile
      // Admins can edit any profile
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }
  }
}
